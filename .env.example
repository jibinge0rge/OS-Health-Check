# --- Required: PostgreSQL is the only storage backend, no file fallback ---
DATABASE_URL=postgresql://oshealth:oshealth@db:5432/oshealth
LOOKUP_DB_ENABLED=true

POSTGRES_USER=oshealth
POSTGRES_PASSWORD=oshealth
POSTGRES_DB=oshealth

# --- Optional: AI providers (leave blank to disable) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# --- Optional: app runtime ---
APP_PORT=8000
UVICORN_RELOAD=false

# --- Auth (required, no fallback) --- see KEYCLOAK_SETUP.md for what these
# mean and how to stand up Keycloak to get real values.
#
# This deployment's tenant key in the shared Postgres -- independent of
# Keycloak on purpose, give every deployment sharing this DB its own value.
DEPLOYMENT_ID=dev
# This deployment's Keycloak realm issuer, e.g.
# http://localhost:8081/realms/os-health-check-dev (the bundled docker-compose
# Keycloak, KEYCLOAK_SETUP.md §3.1). Same value across every
# deployment if using one shared realm, or unique per deployment otherwise.
KEYCLOAK_ISSUER_URL=http://localhost:8081/realms/os-health-check-dev
# The public (PKCE, no secret) client id created for this app in that realm.
KEYCLOAK_AUDIENCE=os-health-check-web
# Realm role gating who may publish a draft into the shared Data. Optional
# -- defaults to this value in code even if left unset.
KEYCLOAK_PUBLISHER_ROLE=lookup-publisher
# Optional -- only needed when this server can't reach KEYCLOAK_ISSUER_URL
# itself (e.g. Keycloak bundled in docker-compose's --profile keycloak --
# see docker-compose.yml). Defaults to KEYCLOAK_ISSUER_URL if unset.
KEYCLOAK_INTERNAL_URL=
