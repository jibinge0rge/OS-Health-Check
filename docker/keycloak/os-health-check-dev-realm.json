{
  "realm": "os-health-check-dev",
  "enabled": true,
  "registrationAllowed": false,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "lookup-publisher",
        "description": "Can publish a draft into the shared Data (AUTH_MULTITENANCY_PLAN.md §6.3)."
      }
    ]
  },
  "clients": [
    {
      "clientId": "os-health-check-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8000/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "publisher",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Publisher",
      "email": "publisher@example.com",
      "credentials": [
        { "type": "password", "value": "publisher123", "temporary": false }
      ],
      "realmRoles": ["lookup-publisher"]
    },
    {
      "username": "editor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Editor",
      "email": "editor@example.com",
      "credentials": [
        { "type": "password", "value": "editor123", "temporary": false }
      ]
    }
  ]
}
